<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/nova_widget_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical">
  <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Nova · Hôm nay" android:textColor="#4A2B1A" android:textStyle="bold" android:textSize="15sp"/>
  <TextView android:id="@+id/widget_toggle" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:text="Hiện tiền" android:textColor="#A94F0A" android:paddingHorizontal="8dp" android:textSize="12sp"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="38dp" android:gravity="center_vertical">
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đã chi" android:textColor="#886449" android:textSize="11sp"/>
   <TextView android:id="@+id/widget_expense" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="*****" android:textColor="#4A2B1A" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
  </LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đã thu" android:textColor="#886449" android:textSize="11sp"/>
   <TextView android:id="@+id/widget_income" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="*****" android:textColor="#4A2B1A" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
  </LinearLayout>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:layout_marginTop="4dp">
  <TextView android:id="@+id/widget_expense_button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@drawable/nova_widget_button" android:gravity="center" android:text="Chi" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp"/>
  <TextView android:id="@+id/widget_income_button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@drawable/nova_widget_secondary" android:gravity="center" android:text="Thu" android:textColor="#7A4A28" android:textStyle="bold" android:textSize="12sp" android:layout_marginStart="6dp"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_category" android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:text="Chọn danh mục  ▾" android:textSize="13sp" android:textColor="#4A2B1A" android:singleLine="true" android:ellipsize="end"/>
 <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mở app để đăng nhập" android:textColor="#886449" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:layout_marginBottom="4dp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="40dp">
  <TextView android:id="@+id/widget_add" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@drawable/nova_widget_button" android:gravity="center" android:text="Thêm giao dịch" android:contentDescription="Thêm giao dịch từ widget" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="13sp"/>
  <ImageButton android:id="@+id/widget_voice" android:layout_width="40dp" android:layout_height="match_parent" android:background="@drawable/nova_widget_secondary" android:src="@drawable/nova_widget_mic" android:contentDescription="Nói giao dịch từ widget" android:layout_marginStart="6dp" android:padding="10dp"/>
  <ImageButton android:id="@+id/widget_camera" android:layout_width="40dp" android:layout_height="match_parent" android:background="@drawable/nova_widget_secondary" android:src="@drawable/nova_widget_camera" android:contentDescription="Chụp hóa đơn bằng AI từ widget" android:layout_marginStart="6dp" android:padding="10dp"/>
 </LinearLayout>
</LinearLayout>
