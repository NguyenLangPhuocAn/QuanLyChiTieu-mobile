<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/nova_widget_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
  <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Nova · Hôm nay" android:textColor="#4A2B1A" android:textStyle="bold" android:textSize="16sp"/>
  <TextView android:id="@+id/widget_toggle" android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center" android:text="Hiện tiền" android:textColor="#A94F0A" android:paddingHorizontal="8dp" android:textSize="12sp"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đã chi" android:textColor="#886449" android:textSize="12sp"/>
   <TextView android:id="@+id/widget_expense" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="*****" android:textColor="#4A2B1A" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
  </LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đã thu" android:textColor="#886449" android:textSize="12sp"/>
   <TextView android:id="@+id/widget_income" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="*****" android:textColor="#4A2B1A" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
  </LinearLayout>
 </LinearLayout>
 <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mở app để đăng nhập" android:textColor="#886449" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:layout_marginVertical="8dp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="44dp">
  <TextView android:id="@+id/widget_expense_button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@drawable/nova_widget_button" android:gravity="center" android:text="− Chi" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp"/>
  <TextView android:id="@+id/widget_income_button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@drawable/nova_widget_button" android:gravity="center" android:text="+ Thu" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp" android:layout_marginStart="8dp"/>
 </LinearLayout>
</LinearLayout>
